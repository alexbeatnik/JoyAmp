<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="2dp"
    android:paddingEnd="10dp"
    android:paddingBottom="4dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_logo"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_music_note"
            app:tint="@color/ja_on_accent" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/ja_text"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/indShuffle"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@string/setting_shuffle"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/ja_text_3" />

        <ImageView
            android:id="@+id/indRepeat"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/setting_repeat"
            android:src="@drawable/ic_repeat"
            app:tint="@color/ja_text_3" />
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@anim/page_in"
        android:outAnimation="@anim/page_out">

        <!-- HOME: now playing card + library -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_art">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music_note"
                            app:tint="@color/ja_on_accent" />

                        <ImageView
                            android:id="@+id/artImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_art_clip"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/trackState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/paused"
                            android:textAllCaps="true"
                            android:textColor="@color/ja_accent"
                            android:textSize="9sp" />

                        <TextView
                            android:id="@+id/trackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="marquee"
                            android:fontFamily="sans-serif-medium"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:text="@string/nothing_playing"
                            android:textColor="@color/ja_text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/trackSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/ja_text_2"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginStart="-5dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="-5dp"
                    android:background="@null"
                    android:focusable="false"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:progressDrawable="@drawable/seek_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb"
                    android:thumbOffset="5dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timePos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:text="0:00"
                        android:textColor="@color/ja_text_2"
                        android:textSize="10sp" />

                    <ImageButton
                        android:id="@+id/btnPrev"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_btn"
                        android:contentDescription="@string/prev"
                        android:focusable="false"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_prev"
                        app:tint="@color/ja_text" />

                    <ImageButton
                        android:id="@+id/btnPlay"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_play_btn"
                        android:contentDescription="@string/play"
                        android:elevation="2dp"
                        android:focusable="false"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play"
                        app:tint="@color/ja_on_accent" />

                    <ImageButton
                        android:id="@+id/btnNext"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_icon_btn"
                        android:contentDescription="@string/next"
                        android:focusable="false"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_skip_next"
                        app:tint="@color/ja_text" />

                    <TextView
                        android:id="@+id/timeDur"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="@color/ja_text_2"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>


            <TextView
                android:id="@+id/a11yWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_warning"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="@string/a11y_off_warning"
                android:textColor="@color/ja_accent"
                android:textSize="10.5sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:layout_marginBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.14"
                    android:text="@string/library"
                    android:textColor="@color/ja_text_3"
                    android:textSize="9.5sp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="@color/ja_text_3"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/songList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:fadeScrollbars="true"
                    android:focusable="false"
                    android:overScrollMode="never"
                    android:paddingBottom="4dp"
                    android:scrollbarSize="3dp"
                    android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/emptyView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_setting_icon"
                        android:importantForAccessibility="no"
                        android:padding="11dp"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/ja_accent" />

                    <TextView
                        android:id="@+id/emptyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/no_folder"
                        android:textColor="@color/ja_text"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center"
                        android:text="@string/empty_hint"
                        android:textColor="@color/ja_text_3"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- SETTINGS -->
        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="2dp">

                <include
                    android:id="@+id/rowFolder"
                    layout="@layout/item_setting" />

                <include
                    android:id="@+id/rowRefresh"
                    layout="@layout/item_setting" />

                <include
                    android:id="@+id/rowShuffle"
                    layout="@layout/item_setting" />

                <include
                    android:id="@+id/rowRepeat"
                    layout="@layout/item_setting" />

                <include
                    android:id="@+id/rowTouch"
                    layout="@layout/item_setting" />

                <include
                    android:id="@+id/rowJoystick"
                    layout="@layout/item_setting" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="8dp"
                    android:text="@string/settings_hint"
                    android:textColor="@color/ja_text_3"
                    android:textSize="10sp" />
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>

    <!-- Key hints -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/keyA"
            style="@style/JoyAmp.Keycap"
            android:text="◂ ▸" />

        <TextView
            android:id="@+id/labelA"
            style="@style/JoyAmp.KeyLabel"
            android:text="@string/hint_track" />

        <TextView
            android:id="@+id/keyB"
            style="@style/JoyAmp.Keycap"
            android:text="OK" />

        <TextView
            android:id="@+id/labelB"
            style="@style/JoyAmp.KeyLabel"
            android:text="@string/hint_play" />

        <TextView
            android:id="@+id/keyC"
            style="@style/JoyAmp.Keycap"
            android:text="#" />

        <TextView
            android:id="@+id/labelC"
            style="@style/JoyAmp.KeyLabel"
            android:layout_marginEnd="0dp"
            android:text="@string/hint_settings" />
    </LinearLayout>
</LinearLayout>
