<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ja_surface_hi" />
            <stroke android:width="1.5dp" android:color="@color/ja_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ja_accent_soft" />
            <stroke android:width="1dp" android:color="@color/ja_outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ja_surface" />
            <stroke android:width="1dp" android:color="@color/ja_outline" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
